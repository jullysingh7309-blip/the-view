            <li><a href="https://www.linkedin.com/company/theviewapp" target="_blank"><i class="icon-linkedin2"></i></a></li>
        </ul>
    </div>

</aside>
<script type="text/javascript" src="//code.jquery.com/jquery-1.10.0.min.js"></script>
<script>
        $(document).ready(function () {
            $.ajaxSetup({ cache: false });
            $('#search').keyup(function(){
                $('#result').html('');
                var searchField = $('#search').val();
                var expression = new RegExp(searchField, "i");
                    $.ajax({
                        url: "/search_hashtag",
                        dataType: "jsonp",
                        type: "GET",
                        data: searchField,  // request is the value of search input
                        success: function (data) {
                            $.each(data, function(key, value){
                                if (value.tagName.search(expression) != -1)
                                {
                                    $('#result').append('<li class="list-group-item link-class"><a href="/hashtag/'+value.tagName+'"> '+value.tagName+'</li>');
                                }
                            });
                        }
                    });
            })
        });
</script>
