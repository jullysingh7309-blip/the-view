</style>
<a href="#" class="js-colorlib-nav-toggle colorlib-nav-toggle"><i></i></a>
<aside id="colorlib-aside" role="complementary" class="border js-fullheight">
    <h1 id="colorlib-logo"><a href="/"><img src="/front-panel/images/logo-view.png" style="width: auto; height: 50px">
         VIEW</a></h1>
    <nav id="colorlib-main-menu" role="navigation">
        <ul>
            <!--<li class="colorlib-active"><a href="/">Trending</a></li>-->
            <li><a href="/" style="color: black">Trending</a></li>
            <li><a href="/business" style="color: black">Business</a></li>
            <li><a href="/technology" style="color: black">Technology</a></li>
            <li><a href="/health" style="color: black">Health</a></li>
            <li><a href="/entertainment" style="color: black">Entertainment</a></li>
            <li><a href="/sports" style="color: black">Sports</a></li>
        </ul>
    </nav>
    <br>
    <br>
    <div class="side animate-box fadeInUp animated" style="margin-bottom: 0 !important;">
    <div class="form-group">
        <input class="form-control" id="search" placeholder="Search">
        <ul class="list-group" id="result"></ul>
    </div>
    </div>

    {{#each tags}}
        <a href="/hashtag/{{this.tagName}}" style="color:orangered; font-size: small; font-weight: bolder ">#{{this.tagName}}</a>
    {{/each}}

    <div class="colorlib-footer">
