{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "function": "app",
        "headers": [{
          "key": "Cache-Control",
          "value": "max-age=900, s-maxage=1800"
        }]
      }
    ]
  }
}
